{
  "name": "touchline-manager",
  "version": "0.15.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node packages/server/src/index.mjs",
    "start": "node packages/server/src/index.mjs",
    "build": "vite build --config packages/client/vite.config.ts",
    "typecheck": "tsc -p packages/client/tsconfig.json",
    "test": "node scripts/validate.mjs --quick --tests-only",
    "test:smoke": "node scripts/validate.mjs --only smoke",
    "test:business": "node scripts/validate.mjs --only business",
    "test:match": "node scripts/validate.mjs --only match",
    "test:season": "node scripts/validate.mjs --only season",
    "check": "node scripts/validate.mjs",
    "check:quick": "node scripts/validate.mjs --quick",
    "check:plan": "node scripts/validate.mjs --plan",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
