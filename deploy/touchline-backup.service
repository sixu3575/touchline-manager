[Unit]
Description=TOUCHLINE consistent database backup
After=touchline-manager.service

[Service]
Type=oneshot
User=football
Group=football
WorkingDirectory=/srv/touchline-manager/current
EnvironmentFile=/etc/touchline-manager.env
Environment=BACKUP_DIR=/var/backups/touchline-manager
ExecStart=/usr/bin/node /srv/touchline-manager/current/scripts/backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/touchline-manager /var/backups/touchline-manager

